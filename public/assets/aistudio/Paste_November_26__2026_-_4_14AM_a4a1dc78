    <div class="nav-actions">
      <button class="btn-back" id="backBtn" onclick="changeStep(-1)" style="visibility:hidden;">Back</button>
      <button class="btn-mint" id="nextBtn" onclick="changeStep(1)">Continue</button>
    </div>
  </div>

  <script>
    let currentStep = 0;
    const panels = document.querySelectorAll('.step-panel');
    const dots = document.querySelectorAll('.dot');

    function renderStep() {
      panels.forEach((p, i) => p.classList.toggle('active', i === currentStep));
      dots.forEach((d, i) => d.classList.toggle('active', i <= currentStep));
      document.getElementById('backBtn').style.visibility = currentStep === 0 ? 'hidden' : 'visible';
      document.getElementById('nextBtn').textContent = currentStep === panels.length - 1 ? 'Open Dashboard' : 'Continue';
    }

    function changeStep(delta) {
      if (currentStep + delta >= panels.length) {
        window.location.href = 'home.html';
        return;
      }
      currentStep = Math.max(0, currentStep + delta);
      renderStep();
    }

    function simulateGrant() {
      const banner = document.getElementById('permBanner');
      banner.classList.remove('pending');
      document.getElementById('permLabel').textContent = 'Enabled ✓';
    }
  </script>
</body>
